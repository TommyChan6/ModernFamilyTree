{
  "name": "family-tree",
  "version": "1.0.0",
  "description": "Desktop family tree application",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dev:web": "vite --config vite.config.web.js",
    "build:web": "vite build --config vite.config.web.js",
    "preview:web": "vite preview --config vite.config.web.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "d3": "^7.9.0",
    "electron": "^31.1.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.7.0",
    "javascript-obfuscator": "^5.5.0",
    "pinia": "^2.1.7",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "d3-force-3d": "^3.0.6",
    "three": "^0.169.0"
  }
}

# Dependencies
node_modules/

# Build output
out/
dist/

# Environment files
.env
.env.*
# …except the production web config: it holds only public values (backend
# selector + Supabase URL + public anon key) and is committed so deploys don't
# depend on dashboard env vars. NEVER put the service_role key in here.
!.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*
